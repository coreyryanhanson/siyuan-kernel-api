{
	"name": "siyuan-kernel-api",
	"version": "0.0.0",
	"description": "Typed client for the SiYuan kernel HTTP API. Zero runtime dependencies.",
	"type": "module",
	"main": "./index.ts",
	"types": "./index.ts",
	"exports": {
		".": {
			"types": "./index.ts",
			"default": "./index.ts"
		}
	},
	"files": [
		"index.ts",
		"client.ts",
		"errors.ts",
		"types.ts"
	],
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"prepublishOnly": "npm test && npx tsc --noEmit && node scripts/check-pack.mjs",
		"release:patch": "node scripts/release.mjs patch",
		"release:minor": "node scripts/release.mjs minor",
		"release:major": "node scripts/release.mjs major",
		"lint": "oxlint --deny-warnings",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"prepare": "husky"
	},
	"engines": {
		"node": ">=20"
	},
	"author": "Corey Ryan Hanson",
	"license": "AGPL-3.0-or-later",
	"devDependencies": {
		"@types/node": "22.20.2",
		"husky": "9.1.7",
		"lint-staged": "17.5.1",
		"oxfmt": "0.66.0",
		"oxlint": "1.81.0",
		"typescript": "^7.0.2",
		"vitest": "^5.0.0"
	},
	"lint-staged": {
		"*.ts": [
			"oxfmt",
			"oxlint --fix --deny-warnings"
		]
	}
}
